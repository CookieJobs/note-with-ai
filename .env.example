// .env.example
PORT='3001'
MONGODB_URI='mongodb://localhost:27017/noteWithAI'
DEEPSEEK_API_KEY='your_deepseek_api_key'
DASHSCOPE_API_KEY='your_dashscope_api_key_here'
OPENROUTER_API_KEY='your_openrouter_api_key_here'
OPENROUTER_BASE_URL='https://openrouter.ai/api/v1'
EMBEDDING_PROVIDER='openrouter'
EMBEDDING_MODEL='nvidia/llama-nemotron-embed-vl-1b-v2:free'
EMBEDDING_DIMENSION='2048'
EMBEDDING_MODALITY='text'
EMBEDDING_QUERY_INPUT_TYPE='query'
EMBEDDING_DOCUMENT_INPUT_TYPE='passage'
JWT_SECRET='your_jwt_secret'
# Admin secrets must be independently generated; never reuse JWT_SECRET.
ADMIN_JWT_SECRET='replace_with_a_distinct_32_character_admin_jwt_secret'
ADMIN_JWT_EXPIRES_IN='8h'
# Generate with: openssl rand -base64 32
ADMIN_ENCRYPTION_KEY='replace_with_a_base64_encoded_32_byte_key'
REDIS_URL='redis://localhost:6379'
QQ_EMAIL_USER='your_qq_email@qq.com'
QQ_EMAIL_PASS='your_qq_authorization_code'
ALLOWED_ORIGINS='https://bloomy16.com'
